# Serveur API (Contabo, Render...): URL MySQL serveur uniquement. Ne jamais exposer au navigateur.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/mulcv_geoarchives"

# Chiffrement de la connexion MySQL. Active par defaut des que l'hote n'est
# pas local. "disabled" si la base ne sait pas faire TLS (frequent sur du
# mutualise cPanel): le trafic MySQL circule alors en clair sur l'internet
# public, a ne choisir qu'en connaissance de cause.
# Valeurs: "" (auto), "disabled", "required"
DATABASE_SSL=""
# CA du serveur MySQL si TLS est actif et que le certificat n'est pas public
# (colle le contenu du .pem). Sans elle, la connexion reste chiffree mais le
# serveur n'est pas authentifie.
DATABASE_SSL_CA=""
# Nombre de connexions simultanees du pool. A reduire si l'hebergeur MySQL
# plafonne max_user_connections (mutualise cPanel: souvent 10-25).
DATABASE_POOL_SIZE="8"

# Front Vercel: ce front ne parle jamais directement au backend distant, il
# passe par ses propres routes /api qui relaient cote serveur (voir
# lib/geoarchives-server-proxy.ts). NEXT_PUBLIC_GEOARCHIVES_API_BASE_URL
# n'est donc plus utilise et peut rester absent.

# Rendu serveur Vercel et relais /api: URL du backend distant (Contabo,
# Render...). Laisser vide si front et API tournent sur le meme serveur.
GEOARCHIVES_API_BASE_URL=""

# API backend: origines autorisees en CORS. N'est plus sollicite par le
# navigateur une fois le relais Vercel en place (server-a-server, hors CORS),
# mais reste utile pour un appel direct manuel (curl, debogage).
# Exemple production: https://mulcv-geoarchives.vercel.app,https://www.ton-domaine.ci
GEOARCHIVES_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

# API backend: port du serveur Node. Contabo derriere Nginx/Caddy fixe cette
# valeur; Render fournit son propre PORT au demarrage, ne pas le forcer.
PORT="4100"

# Authentification applicative: a configurer sur Vercel et Contabo avec des valeurs reelles.
GEOARCHIVES_AUTH_SECRET="change-this-long-random-secret"
GEOARCHIVES_ADMIN_LOGIN="dac01@ceiba-analytics.com"
GEOARCHIVES_ADMIN_PASSWORD="change-me-admin"
GEOARCHIVES_ADMIN_NAME="Administrateur national"
GEOARCHIVES_EXECUTIVE_LOGIN="executif"
GEOARCHIVES_EXECUTIVE_PASSWORD="change-me-executive"
GEOARCHIVES_EXECUTIVE_NAME="Pilotage national"
GEOARCHIVES_AGENT_ACCOUNTS='[{"login":"agent-abidjan","password":"change-me-agent-abidjan","name":"Agent Abidjan"},{"login":"agent-yamoussoukro","password":"change-me-agent-yamoussoukro","name":"Agent Yamoussoukro"}]'
# Compatibilite optionnelle si tu veux garder temporairement un seul agent:
# GEOARCHIVES_AGENT_LOGIN="agent"
# GEOARCHIVES_AGENT_PASSWORD="change-me-agent"
# GEOARCHIVES_AGENT_NAME="Agent registre"

# Les agents doivent ensuite etre crees depuis la page admin: Gestion des comptes.
# Si la table users manque sur une base existante, executer sql/004_create_users.sql une seule fois.

# Admin bootstrap du module CEIBA /inventaire-ceiba.
# Les comptes crees ensuite dans l'interface CEIBA restent limites a ce module.
CEIBA_INVENTORY_ADMIN_LOGIN="ceibac-admin"
CEIBA_INVENTORY_ADMIN_PASSWORD="change-me-ceibac-admin"
CEIBA_INVENTORY_ADMIN_NAME="Administration CEIBAC"
CEIBA_INVENTORY_SESSION_MAX_AGE_SECONDS="43200"

# Email et reinitialisation de mot de passe
# L'alias doit etre valide dans Resend sur le domaine ceiba-analytics.com.
# Exemple pro : "GeoArchives <geoarchives@ceiba-analytics.com>"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GeoArchives <geoarchives@ceiba-analytics.com>"
PASSWORD_RESET_REDIRECT_URL="https://geoarchiv.ceiba-analytics.com/reset-password"
