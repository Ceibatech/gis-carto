# Variables a saisir dans le tableau de bord Render (Environment), pas dans
# render.yaml: celles marquees sync: false n'y sont pas commitees.
# NODE_ENV et PORT sont geres par Render lui-meme, ne pas les fixer ici.

DATABASE_URL=mysql://compte_utilisateur:MOTDEPASSE@srvXXX.hebergeur.com:3306/compte_base

# A regler sur "disabled" si le MySQL cible ne supporte pas TLS (verifier
# avec SHOW VARIABLES LIKE 'have_ssl'; dans phpMyAdmin: DISABLED confirme
# l'absence de support). Le trafic MySQL circule alors en clair sur
# l'internet public.
DATABASE_SSL=disabled

# A reduire (3-5) si l'hebergeur MySQL plafonne max_user_connections
# (frequent sur du mutualise cPanel).
DATABASE_POOL_SIZE=5

GEOARCHIVES_ALLOWED_ORIGINS=https://mulcv-geoarchives.vercel.app

# Identique a la variable de meme nom sur Vercel: render.yaml genere une
# valeur au premier deploiement (generateValue: true), a copier ensuite vers
# Vercel. Sans cette egalite, les sessions signees ici ne sont jamais
# reconnues par le relais du front.
GEOARCHIVES_AUTH_SECRET=change-this-long-random-secret

GEOARCHIVES_ADMIN_LOGIN=dac01@ceiba-analytics.com
GEOARCHIVES_ADMIN_PASSWORD=change-me-admin
GEOARCHIVES_ADMIN_NAME=Administrateur national
GEOARCHIVES_EXECUTIVE_LOGIN=executif
GEOARCHIVES_EXECUTIVE_PASSWORD=change-me-executive
GEOARCHIVES_EXECUTIVE_NAME=Pilotage national
GEOARCHIVES_AGENT_ACCOUNTS='[{"login":"agent-abidjan","password":"change-me-agent-abidjan","name":"Agent Abidjan"}]'

CEIBA_INVENTORY_ADMIN_LOGIN=ceibac-admin
CEIBA_INVENTORY_ADMIN_PASSWORD=change-me-ceibac-admin
CEIBA_INVENTORY_ADMIN_NAME=Administration CEIBAC
CEIBA_INVENTORY_SESSION_MAX_AGE_SECONDS=43200

RESEND_API_KEY=
RESEND_FROM_EMAIL=support@ceiba-analytics.com
PASSWORD_RESET_REDIRECT_URL=https://geoarchiv.ceiba-analytics.com/reset-password
